{
    "name": "s2j-media-library-date-corrector",
    "version": "1.0.11",
    "description": "Designed to resolve metadata inconsistencies that occur after bulk media uploads in WordPress. Correct attachment post_date values from uploads path year/month.",
    "type": "module",
    "author": "Koutarou ISHIKAWA",
    "license": "GPL-3.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/stein2nd/s2j-media-library-date-corrector.git"
    },
    "homepage": "https://github.com/stein2nd/s2j-media-library-date-corrector#readme",
    "bugs": {
        "url": "https://github.com/stein2nd/s2j-media-library-date-corrector/issues"
    },
    "keywords": [
        "wordpress",
        "plugin",
        "media",
        "library",
        "date",
        "corrector"
    ],
    "main": "s2j-media-library-date-corrector.php",
    "scripts": {
        "lint:docs": "s2j-docs-linter ./README.md ./CHANGELOG.md ./docs/**/*.md ./docs_mod/**/*.md",
        "lint": "npm run lint:ts && npm run lint:scss",
        "lint:fix": "npm run lint:ts:fix && npm run lint:scss:fix",
        "lint:ts": "eslint \"src/**/*.{ts,tsx}\" --no-error-on-unmatched-pattern",
        "lint:ts:fix": "eslint \"src/**/*.{ts,tsx}\" --no-error-on-unmatched-pattern --fix",
        "lint:scss": "stylelint \"src/**/*.scss\" --allow-empty-input",
        "lint:scss:fix": "stylelint \"src/**/*.scss\" --allow-empty-input --fix",
        "lint:php": "composer lint:php",
        "phpstan": "composer phpstan",
        "phpcs": "composer phpcs",
        "phpcs:wpcs": "composer phpcs:wpcs",
        "build": "NODE_ENV=production vite build",
        "build:dev": "vite build",
        "dist:build": "FLUSH_DIST=true npm run build",
        "dist:zip": "node tools/dist/make-dist-zip.mjs",
        "dist": "npm run dist:build && npm run dist:zip",
        "makepot": "wp i18n make-pot . languages/s2j-media-library-date-corrector.pot --domain=s2j-media-library-date-corrector",
        "makemo": "wp i18n make-mo languages",
        "makejson": "wp i18n make-json languages --no-purge",
        "makei18n": "npm run makemo && npm run makejson",
        "postbuild:production:gutenberg": "npm run makejson",
        "wp-env": "wp-env",
        "pretest:phpunit": "composer install --no-interaction --prefer-dist",
        "phpunit": "composer test",
        "phpunit:local": "vendor/bin/phpunit -c phpunit.xml.dist",
        "prephpunit:wp-env": "composer install --no-interaction --prefer-dist",
        "phpunit:wp-env": "npm run test:unit:php",
        "pretest:unit:php": "wp-env start",
        "test:unit:php": "wp-env run tests-wordpress wp-content/plugins/s2j-media-library-date-corrector/bin/phpunit-ci.sh",
        "test:unit:php:local": "bash bin/phpunit-local.sh",
        "test:unit:php:unit-only": "composer test:unit",
        "test:smoke:local": "bash tests/smoke-local.sh",
        "test:smoke:studio:rebuild": "bash tests/studio-rebuild.sh",
        "pretest:unit:php:local": "composer install --no-interaction --prefer-dist",
        "pretest:lint:php": "composer install --no-interaction --prefer-dist"
    },
    "dependencies": {
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    },
    "overrides": {
        "rollup": "^4.65.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@s2j/docs-linter": "^1.0.30",
        "@types/jquery": "^4.0.1",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@typescript-eslint/eslint-plugin": "^8.72.0",
        "@typescript-eslint/parser": "^8.72.0",
        "@typescript/native": "npm:typescript@^7.0.2",
        "@wordpress/api-fetch": "^8.0.0",
        "@wordpress/block-editor": "^19.0.0",
        "@wordpress/blocks": "^17.0.0",
        "@wordpress/components": "^43.0.0",
        "@wordpress/data": "^11.0.0",
        "@wordpress/element": "^10.0.0",
        "@wordpress/env": "^12.0.0",
        "@wordpress/i18n": "^7.0.0",
        "@wordpress/url": "^5.0.0",
        "autoprefixer": "^10.6.1",
        "eslint": "^10.13.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "rollup": "^4.65.0",
        "sass": "^1.106.1",
        "stylelint": "^17.16.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "vite": "^8.3.5",
        "vite-plugin-static-copy": "^4.1.1"
    },
    "allowScripts": {
        "@s2j/docs-linter": true
    }
}
