{
  "name": "s2j-media-library-date-corrector",
  "version": "1.0.7",
  "description": "S2J MediaLibrary Date Corrector is a tool designed to resolve metadata inconsistencies that occur after bulk media uploads in WordPress.",
  "type": "module",
  "author": "Koutarou ISHIKAWA",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stein2nd/s2j-media-library-date-corrector.git"
  },
  "homepage": "https://github.com/stein2nd/s2j-media-library-date-corrector#readme",
  "bugs": {
    "url": "https://github.com/stein2nd/s2j-media-library-date-corrector/issues"
  },
  "keywords": [
    "wordpress",
    "plugin",
    "media",
    "library",
    "date",
    "corrector"
  ],
  "main": "s2j-media-library-date-corrector.php",
  "scripts": {
    "build": "NODE_ENV=production vite build",
    "build:dev": "vite build",
    "dist:build": "FLUSH_DIST=true npm run build",
    "dist:zip": "node tools/dist/make-dist-zip.mjs",
    "dist": "npm run dist:build && npm run dist:zip",
    "lint": "npm run lint:ts && npm run lint:scss",
    "lint:fix": "npm run lint:ts:fix && npm run lint:scss:fix",
    "lint:ts": "eslint \"src/**/*.{ts,tsx}\" --no-error-on-unmatched-pattern",
    "lint:ts:fix": "eslint \"src/**/*.{ts,tsx}\" --no-error-on-unmatched-pattern --fix",
    "lint:scss": "stylelint \"src/**/*.scss\" --allow-empty-input",
    "lint:scss:fix": "stylelint \"src/**/*.scss\" --allow-empty-input --fix",
    "lint:docs": "s2j-docs-linter ./README.md ./CHANGELOG.md ./docs/**/*.md ./docs_mod/**/*.md",
    "makepot": "wp i18n make-pot . languages/s2j-media-library-date-corrector.pot --domain=s2j-media-library-date-corrector",
    "wp-env": "wp-env",
    "pretest:phpunit": "composer install --no-interaction --prefer-dist",
    "phpunit": "composer test",
    "phpunit:local": "vendor/bin/phpunit -c phpunit.xml.dist",
    "prephpunit:wp-env": "composer install --no-interaction --prefer-dist",
    "phpunit:wp-env": "npm run test:unit:php",
    "pretest:unit:php": "wp-env start",
    "test:unit:php": "wp-env run tests-wordpress phpunit -c wp-content/plugins/s2j-media-library-date-corrector/phpunit.xml.dist",
    "test:unit:php:local": "npm run phpunit:local",
    "test:smoke:local": "bash tests/smoke-local.sh",
    "test:smoke:studio:rebuild": "bash tests/studio-rebuild.sh"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "overrides": {
    "rollup": "^4.64.5",
    "serialize-javascript": "^7.1.2",
    "markdownlint-cli": {
      "js-yaml": "^5.4.2"
    },
    "sockjs": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@s2j/docs-linter": "^1.0.27",
    "@types/jquery": "^4.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@wordpress/api-fetch": "^7.57.0",
    "@wordpress/block-editor": "^18.1.0",
    "@wordpress/blocks": "^16.2.0",
    "@wordpress/components": "^42.0.0",
    "@wordpress/data": "^10.57.0",
    "@wordpress/element": "^9.0.0",
    "@wordpress/env": "^10.39.0",
    "@wordpress/i18n": "^6.30.0",
    "@wordpress/scripts": "^36.1.0",
    "@wordpress/url": "^4.57.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "rollup": "^4.64.5",
    "sass": "^1.105.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.4",
    "vite-plugin-static-copy": "^4.1.1"
  },
  "allowScripts": {
    "@s2j/docs-linter": true
  }
}
