{
  "name": "s2j-media-library-date-corrector",
  "version": "1.0.3",
  "description": "S2J MediaLibrary Date Corrector is a tool designed to resolve metadata inconsistencies that occur after bulk media uploads in WordPress.",
  "type": "module",
  "author": "Koutarou ISHIKAWA",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stein2nd/s2j-media-library-date-corrector.git"
  },
  "homepage": "https://github.com/stein2nd/s2j-media-library-date-corrector#readme",
  "bugs": {
    "url": "https://github.com/stein2nd/s2j-media-library-date-corrector/issues"
  },
  "keywords": [
    "wordpress",
    "plugin",
    "media",
    "library",
    "date",
    "corrector"
  ],
  "main": "s2j-media-library-date-corrector.php",
  "scripts": {
    "lint": "npm run lint:ts && npm run lint:scss",
    "lint:fix": "npm run lint:ts:fix && npm run lint:scss:fix",
    "lint:ts": "eslint \"src/**/*.{ts,tsx}\" --no-error-on-unmatched-pattern",
    "lint:ts:fix": "eslint \"src/**/*.{ts,tsx}\" --no-error-on-unmatched-pattern --fix",
    "lint:scss": "stylelint \"src/**/*.scss\" --allow-empty-input",
    "lint:scss:fix": "stylelint \"src/**/*.scss\" --allow-empty-input --fix",
    "lint:docs": "s2j-docs-linter ./README.md ./CHANGELOG.md ./docs/**/*.md ./docs_mod/**/*.md"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "overrides": {
    "rollup": "^4.63.1"
  },
  "devDependencies": {
    "@s2j/docs-linter": "^1.0.24",
    "@types/jquery": "^4.0.1",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@wordpress/api-fetch": "^7.54.0",
    "@wordpress/block-editor": "^17.0.0",
    "@wordpress/blocks": "^15.27.0",
    "@wordpress/components": "^40.0.0",
    "@wordpress/data": "^10.54.0",
    "@wordpress/element": "^8.6.0",
    "@wordpress/i18n": "^6.27.0",
    "@wordpress/scripts": "^34.2.0",
    "@wordpress/url": "^4.54.0",
    "autoprefixer": "^10.5.5",
    "eslint": "^10.10.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "rollup": "^4.63.1",
    "sass": "^1.104.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-static-copy": "^4.1.1"
  },
  "allowScripts": {
    "@s2j/docs-linter": true
  }
}
