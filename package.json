    "lint:fix": "npm run lint:ts:fix && npm run lint:scss:fix",
    "lint:ts": "eslint src/**/*.{ts,tsx} --ext .ts,.tsx",
    "lint:ts:fix": "eslint src/**/*.{ts,tsx} --ext .ts,.tsx --fix",
    "lint:scss": "stylelint src/**/*.scss",
    "lint:scss:fix": "stylelint src/**/*.scss --fix",
    "lint:docs": "s2j-docs-linter ./README.md ./docs/**/*.md ./docs_mod/**/*.md"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "overrides": {
    "rollup": "^4.60.4"
  },
  "devDependencies": {
    "@s2j/docs-linter": "^1.0.11",
    "@types/jquery": "^4.0.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@wordpress/api-fetch": "^7.46.0",
    "@wordpress/block-editor": "^15.19.0",
    "@wordpress/blocks": "^15.19.0",
    "@wordpress/components": "^33.1.0",
    "@wordpress/data": "^10.46.0",
    "@wordpress/element": "^6.46.0",
    "@wordpress/i18n": "^6.19.0",
    "@wordpress/scripts": "^32.2.0",
    "@wordpress/url": "^4.46.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.4.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "rollup": "^4.60.4",
    "sass": "^1.100.0",
    "stylelint": "^17.12.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vite-plugin-static-copy": "^4.1.0"
  }
