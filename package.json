{
  "name": "s2j-media-library-date-corrector",
  "version": "1.0.1",
  "description": "S2J MediaLibrary Date Corrector is a tool designed to resolve metadata inconsistencies that occur after bulk media uploads in WordPress.",
  "type": "module",
  "author": "Koutarou ISHIKAWA",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stein2nd/s2j-media-library-date-corrector.git"
  },
  "homepage": "https://github.com/stein2nd/s2j-media-library-date-corrector#readme",
  "bugs": {
    "url": "https://github.com/stein2nd/s2j-media-library-date-corrector/issues"
  },
  "keywords": [
    "wordpress",
    "plugin",
    "media",
    "library",
    "date",
    "corrector"
  ],
  "main": "s2j-media-library-date-corrector.php",
  "scripts": {
    "lint": "npm run lint:ts && npm run lint:scss",
    "lint:fix": "npm run lint:ts:fix && npm run lint:scss:fix",
    "lint:ts": "eslint src/**/*.{ts,tsx} --ext .ts,.tsx",
    "lint:ts:fix": "eslint src/**/*.{ts,tsx} --ext .ts,.tsx --fix",
    "lint:scss": "stylelint src/**/*.scss",
    "lint:scss:fix": "stylelint src/**/*.scss --fix",
    "lint:docs": "s2j-docs-linter ./README.md ./CHANGELOG.md ./docs/**/*.md ./docs_mod/**/*.md"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "overrides": {
    "rollup": "^4.62.4"
  },
  "devDependencies": {
    "@s2j/docs-linter": "^1.0.22",
    "@types/jquery": "^4.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@wordpress/api-fetch": "^7.52.0",
    "@wordpress/block-editor": "^16.1.0",
    "@wordpress/blocks": "^15.25.0",
    "@wordpress/components": "^38.0.0",
    "@wordpress/data": "^10.52.0",
    "@wordpress/element": "^8.4.0",
    "@wordpress/i18n": "^6.25.0",
    "@wordpress/scripts": "^34.0.0",
    "@wordpress/url": "^4.52.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "rollup": "^4.62.4",
    "sass": "^1.102.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-static-copy": "^4.1.1"
  },
  "allowScripts": {
    "@s2j/docs-linter@1.0.22": true
  }
}
