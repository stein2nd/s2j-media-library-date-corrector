msgid "S2J Media Library Date Corrector"
msgstr "S2J Media Library Date Corrector"

#. Plugin URI of the plugin
#: s2j-media-library-date-corrector.php
msgid "https://github.com/stein2nd/s2j-media-library-date-corrector"
msgstr "https://github.com/stein2nd/s2j-media-library-date-corrector"

#. Description of the plugin
#: s2j-media-library-date-corrector.php
msgid "Designed to resolve metadata inconsistencies that occur after bulk media uploads in WordPress. Correct attachment post_date values from uploads path year/month."
msgstr "WordPress でのメディアの一括アップロード後に発生する、メタデータの不整合を解決するために設計されています。アップロードパス (年/月) に基づいて、添付ファイルの「post_date」値を修正します。"

#. Author of the plugin
#: s2j-media-library-date-corrector.php
msgid "Koutarou ISHIKAWA"
msgstr "Koutarou ISHIKAWA"

#. Author URI of the plugin
#: s2j-media-library-date-corrector.php
msgid "https://stein2nd.wordpress.com"
msgstr "https://stein2nd.wordpress.com"

#: includes/class-s2j-mldc-media-date-service.php:233
msgid "Target media was not found."
msgstr "対象メディアが見つかりませんでした。"

#: includes/class-s2j-mldc-media-date-service.php:241
msgid "You do not have permission to edit this item."
msgstr "この項目を編集する権限がありません。"

#: includes/class-s2j-mldc-media-date-service.php:252
msgid "Could not read year/month from the file path; skipping correction."
msgstr "ファイルパスから「年/月」を読み取れませんでした。修正をスキップします。"

#: includes/class-s2j-mldc-media-date-service.php:266
msgid "The date already matches the path year/month."
msgstr "日付はすでにパスの「年/月」と一致しています。"

#: includes/class-s2j-mldc-media-date-service.php:295
msgid "Date corrected."
msgstr "日付を修正しました。"

#: includes/class-s2j-mldc-media-library-columns.php:46
#: includes/class-s2j-mldc-media-library-columns.php:52
msgid "Year/month (path)"
msgstr "年/月 (パス)"

#: includes/class-s2j-mldc-media-library-columns.php:47
#: includes/class-s2j-mldc-media-library-columns.php:53
msgid "Difference"
msgstr "差分"

#: includes/class-s2j-mldc-media-library-columns.php:77
msgid "Match"
msgstr "一致"

#: includes/class-s2j-mldc-media-library-columns.php:78
msgid "Mismatch"
msgstr "不一致"

#: includes/class-s2j-mldc-media-library-columns.php:79
msgid "Unknown"
msgstr "不明"

#: includes/class-s2j-mldc-media-library-columns.php:94
#: includes/class-s2j-mldc-media-library-columns.php:114
